# Runtime artifacts (binding: runs/ is not source)
/runs/
!runs/.gitkeep
!runs/manifest.jsonl
!runs/archives/
!runs/pilot-*-report.json

# Python
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
/.venv/

# OS / Editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Local archives
foss-launcher.zip
launcher.zip
*.zip
fl.zip

# Reports and analysis artifacts
# Keep most new report outputs ignored, but allow canonical root archive migration docs.
/reports/*
!/reports/root_archive/
!/reports/root_archive/**

# Test baselines and captures
baseline/
baselines/

# Local agent artifacts
AGENTS.md
artifacts/
!/reports/root_archive/artifacts/
!/reports/root_archive/artifacts/**

# Local Claude Code settings (environment-specific)
.claude/settings.local.json

# Temp files and test artifacts
/tmp/
nul
.coverage
TC-*_EVIDENCE.md
TC-*_SUMMARY.md
/_*.py
/_*.txt
test_output.txt
*.backup
/output
/.claude
