+                        value="test1",
+                        start_pos=0,
+                        end_pos=5,
+                        line_number=1,
+                        context="***",
+                        confidence=0.8,
+                    )
+                ],
+            ),
+            ScanResult(
+                file_path="secret2.txt",
+                secrets_found=[
