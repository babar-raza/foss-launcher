+      "properties": {
+        "ok": {
+          "type": "boolean"
+        },
+        "profile": {
+          "type": "string",
+          "enum": ["local", "ci", "prod"]
+        },
+        "gates_passed": {
+          "type": "integer"
+        },
+        "gates_failed": {
+          "type": "integer"
+        }
+      }
+    }
+  }
+}
