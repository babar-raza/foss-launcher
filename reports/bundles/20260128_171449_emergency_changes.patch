+
+    def test_count_total_secrets_excludes_allowlisted(self) -> None:
+        """Test that allowlisted secrets are not counted."""
+        from launch.security.secret_detector import SecretMatch
+
+        results = [
+            ScanResult(
+                file_path="test_secrets.py",
+                secrets_found=[
+                    SecretMatch(
+                        secret_type="api_key",
+                        value="test",
