+            "required_claim_ids": [c["claim_id"] for c in claims if "api" in c.get("claim_group", "").lower()][:5],
+            "required_snippet_tags": snippet_tags[:1] if snippet_tags else [],
+            "cross_links": [],
+            "seo_keywords": [product_slug, platform, "api", "reference"],
+            "forbidden_topics": []
