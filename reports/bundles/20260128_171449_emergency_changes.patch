+            "cross_links": [],
+            "seo_keywords": [product_slug, platform, "faq"],
+            "forbidden_topics": []
+        })
+
+        if launch_tier in ["standard", "rich"]:
+            pages.append({
+                "section": "kb",
+                "slug": "troubleshooting",
+                "output_path": compute_output_path("kb", "troubleshooting", product_slug, platform=platform),
