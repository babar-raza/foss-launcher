+    """Test content insertion under anchor heading."""
+    content = """# Title
+
+## Section 1
+
+Existing content.
+
+## Section 2
+
+More content.
+"""
+
+    new_content = "New paragraph here."
+    updated = insert_content_at_anchor(content, "Section 1", new_content)
