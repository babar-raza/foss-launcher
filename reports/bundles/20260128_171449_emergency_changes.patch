+                    report.append(f"  - Context: `{issue.context}`")
+                report.append("")
+
+            if infos:
+                report.append("### INFO: TODOs in Other Files")
+                report.append("")
+                # Group by file to reduce noise
+                by_file = defaultdict(list)
+                for issue in infos:
+                    by_file[issue.file_path].append(issue)
