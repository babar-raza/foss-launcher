+            description="Retrieve telemetry data for a specific run via MCP protocol.",
+            inputSchema={
+                "type": "object",
+                "properties": {
+                    "run_id": {
+                        "type": "string",
+                        "description": "Run identifier (format: YYYYMMDD-HHMM)",
