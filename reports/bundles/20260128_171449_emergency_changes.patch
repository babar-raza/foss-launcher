+       """Same inputs produce same issue ID."""
+       id1 = derive_issue_id("hugo_build", "build_failed", "content/en/products/page.md", 42)
+       id2 = derive_issue_id("hugo_build", "build_failed", "content/en/products/page.md", 42)
