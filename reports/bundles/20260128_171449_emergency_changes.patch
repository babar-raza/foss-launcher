+
+    events_file = run_layout.run_dir / "events.ndjson"
+
+    def write_event(event_type: str, payload: Dict[str, Any]) -> None:
+        """Helper to write a single event to events.ndjson."""
+        event = Event(
+            event_id=str(uuid.uuid4()),
+            run_id=run_id,
