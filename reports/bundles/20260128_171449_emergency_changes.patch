+            "API_KEY = 'abc123def456ghi789jkl012mno345pqr678'",
+            encoding="utf-8",
+        )
+
+        tests = tmp_path / "tests"
+        tests.mkdir()
+        (tests / "test_secrets.py").write_text(
+            "# Test file\ntest_password = 'test123'",
+            encoding="utf-8",
+        )
