+                        end_pos=4,
+                        line_number=1,
+                        context="***",
+                        confidence=0.8,
+                    )
+                ],
+                is_allowlisted=True,
+            ),
+        ]
+
+        count = count_total_secrets(results)
+
+        assert count == 0
+
+
+class TestScanIntegration:
+    """Integration tests for file scanning."""
+
+    def test_scan_project_structure(self, tmp_path: Path) -> None:
