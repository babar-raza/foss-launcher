{
  "permissions": {
    "allow": [
      "Bash(python -m json.tool:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe scripts/check_taskcard.py"
          }
        ]
      }
    ]
  }
}
