{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_cache",
  "description": "Hash-based worker skip cache artifact. Written when caching.enabled=true.",
  "type": "object",
  "required": ["schema_version", "enabled"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "enabled": { "type": "boolean" },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["input_hash", "output_hash"],
        "properties": {
          "input_hash": { "type": "string" },
          "output_hash": { "type": "string" }
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["draft_path"],
        "properties": {
          "draft_path": { "type": "string" },
          "input_hash": { "type": "string", "description": "TC-2450: SHA256 of page inputs; used to detect unchanged pages on rerun." }
        }
      }
    }
  }
}
