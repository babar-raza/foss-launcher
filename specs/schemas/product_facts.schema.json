{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_facts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_name",
    "product_slug",
    "repo_url",
    "repo_sha",
    "positioning",
    "supported_platforms",
    "claims",
    "claim_groups",
    "supported_formats",
    "workflows",
    "api_surface_summary",
    "example_inventory"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_slug": {
      "type": "string"
    },
    "repo_url": {
      "type": "string"
    },
    "repo_sha": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagline",
        "short_description"
      ],
      "properties": {
        "tagline": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "who_it_is_for": {
          "type": "string",
          "description": "Target audience description"
        }
      }
    },
    "supported_platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "claim_groups": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key_features",
        "install_steps",
        "quickstart_steps",
        "workflow_claims",
        "limitations",
        "compatibility_notes"
      ],
      "properties": {
        "key_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "install_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quickstart_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "supported_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "status",
          "claim_id"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "status": {
            "enum": [
              "implemented",
              "planned",
              "unknown"
            ]
          },
          "claim_id": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "import",
              "export",
              "both",
              "unknown"
            ]
          },
          "support_level": {
            "enum": [
              "full",
              "partial",
              "unknown"
            ]
          },
          "notes_claim_id": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Multiple claim IDs associated with this format (used when multiple claims cover the same format)"
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_tag",
          "title",
          "claim_ids"
        ],
        "properties": {
          "workflow_tag": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Human-readable workflow name (OPTIONAL, TC-1040)"
          },
          "description": {
            "type": "string",
            "description": "What this workflow accomplishes (OPTIONAL, TC-1040)"
          },
          "complexity": {
            "enum": ["simple", "moderate", "complex"],
            "description": "Workflow complexity level (OPTIONAL, TC-1040)"
          },
          "estimated_time_minutes": {
            "type": "integer",
            "description": "Estimated completion time in minutes (OPTIONAL, TC-1040)"
          },
          "steps": {
            "type": "array",
            "description": "Ordered steps in workflow (OPTIONAL, TC-1040)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "step_num": {
                  "type": "integer"
                },
                "step_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "claim_id": {
                  "type": ["string", "null"]
                },
                "snippet_id": {
                  "type": ["string", "null"]
                }
              },
              "required": ["step_num", "step_id", "name"]
            }
          },
          "summary_claim_id": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "snippet_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "description": "Source file or document where this workflow was extracted from"
          },
          "workflow_id": {
            "type": "string",
            "description": "Unique identifier for this workflow (e.g., 'wf-load-save-3d')"
          }
        }
      }
    },
    "api_surface_summary": {
      "type": "object",
      "description": "Public API surface (class and function names, NOT claim IDs)",
      "additionalProperties": true,
      "properties": {
        "classes": {
          "type": "array",
          "items": {},
          "description": "Public class names or class objects extracted from source code (e.g., ['Scene', 'FileFormat'] or [{name, methods}])"
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Public function names extracted from source code (e.g., ['load', 'save'])"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Module paths (e.g., ['aspose.threed', 'aspose.threed.entities'])"
        }
      }
    },
    "example_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "example_id",
          "title",
          "tags",
          "primary_snippet_id"
        ],
        "properties": {
          "example_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "What this example teaches (OPTIONAL, TC-1040)"
          },
          "complexity": {
            "enum": ["trivial", "simple", "moderate", "complex"],
            "description": "Example complexity level (OPTIONAL, TC-1040)"
          },
          "audience_level": {
            "enum": ["beginner", "intermediate", "advanced"],
            "description": "Target audience for this example (OPTIONAL, TC-1040)"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primary_snippet_id": {
            "type": "string"
          },
          "related_snippet_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "file_path": {
            "type": "string",
            "description": "Source file path of the example (OPTIONAL, TC-1506)"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spdx_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "distribution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "identifier"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "pip",
              "nuget",
              "maven",
              "npm",
              "cargo",
              "go",
              "docker",
              "source",
              "other"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "install_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extras": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "os": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "dev": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci_present": {
          "type": "boolean"
        },
        "ci_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_present": {
          "type": "boolean"
        },
        "recommended_test_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "code_structure": {
      "type": "object",
      "description": "Code structure information extracted from repository (OPTIONAL, TC-1040)",
      "additionalProperties": false,
      "properties": {
        "source_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source code root directories (e.g., ['src/', 'lib/'])"
        },
        "public_entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Public entrypoint files (e.g., ['__init__.py', 'main.py'])"
        },
        "package_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Package names from manifests (e.g., ['aspose-3d', 'aspose.threed'])"
        }
      }
    },
    "feature_profiles": {
      "type": "array",
      "description": "Structured feature groupings extracted from claims (TC-1411)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "description": "Feature topic name (e.g., 'File Format Support', 'Data Processing')"
          },
          "description": {
            "type": "string",
            "description": "Brief description of this feature topic"
          },
          "claim_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Claim IDs belonging to this feature topic"
          },
          "keywords": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Keywords that define this feature topic"
          },
          "api_classes": {
            "type": "array",
            "items": {"type": "string"},
            "description": "API class names relevant to this feature"
          },
          "audience": {
            "type": "string",
            "description": "Target audience for this feature profile"
          },
          "capabilities": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Specific capabilities within this feature topic"
          },
          "code_example": {
            "type": "string",
            "description": "Representative code snippet for this feature"
          },
          "detail": {
            "type": "string",
            "description": "Detailed description of the feature profile"
          },
          "feature_id": {
            "type": "string",
            "description": "Unique identifier for this feature profile"
          },
          "limitations": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Known limitations of this feature"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for this feature profile"
          },
          "related_claims": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Additional related claim IDs beyond the primary claim_ids list"
          },
          "summary": {
            "type": "string",
            "description": "Brief summary of the feature profile for display"
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Tags for feature categorization and search"
          }
        }
      }
    },
    "product_family": {
      "type": "string",
      "description": "Product family name (e.g., 'cells', '3d', 'note')"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "claim_kind",
        "truth_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "claim_text": {
          "type": "string"
        },
        "claim_kind": {
          "type": "string"
        },
        "truth_status": {
          "enum": [
            "fact",
            "inference",
            "verified"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "default": "high"
        },
        "source_type": {
          "type": "string",
          "description": "Source file classification (e.g., readme_technical, manifest, source_code)"
        },
        "source_relevance": {
          "type": "integer",
          "description": "Source relevance score (0-100) from W1 discovery"
        },
        "source_priority": {
          "type": "integer",
          "description": "Source priority ranking (1=highest, from evidence priority)"
        },
        "evidence_priority": {
          "type": "string",
          "description": "Evidence priority level from W1 (high/medium/low)"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "start_line": {"type": "integer"},
              "end_line": {"type": "integer"}
            },
            "required": ["path", "start_line", "end_line"]
          },
          "description": "Source file citations backing this claim"
        },
        "step_order": {
          "type": "integer",
          "description": "Step ordering within a section (1-based, for workflow decomposition)"
        },
        "enriched_text": {
          "type": "string",
          "description": "Marketing-ready rewrite of claim_text with product context (TC-1622). Original claim_text preserved for claim_id stability."
        },
        "confidence_numeric": {
          "type": ["number", "boolean"],
          "description": "Round 12: Numeric confidence score (0.0-1.0) or boolean for hallucination detection. Complements existing categorical confidence field."
        },
        "audience_level": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"],
          "description": "Round 12: Target audience level for semantic claim selection."
        },
        "enrichment_metadata": {
          "type": "object",
          "description": "Round 12: Metadata about how this claim was enriched.",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": ["llm", "offline_heuristic", "manual"],
              "description": "Enrichment method used"
            },
            "model": {
              "type": "string",
              "description": "LLM model used for enrichment (if method=llm)"
            },
            "version": {
              "type": "string",
              "description": "Enrichment pipeline version"
            },
            "timestamp": {
              "type": "string",
              "description": "ISO 8601 timestamp of enrichment"
            }
          }
        },
        "merge_lineage": {
          "type": "object",
          "description": "Round 12: Incremental merge tracking for claim ID stability across runs.",
          "additionalProperties": false,
          "properties": {
            "previous_run_id": {
              "type": "string",
              "description": "Run ID where this claim was first created"
            },
            "parent_claim_id": {
              "type": "string",
              "description": "Original claim_id if this claim was merged from a previous run"
            },
            "deprecated": {
              "type": "boolean",
              "description": "True if this claim existed in previous run but not in current extraction"
            }
          }
        },
        "benefit": {
          "type": "string",
          "description": "Business or developer benefit of this capability"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "moderate", "complex", "medium"],
          "description": "Complexity level for this claim (use 'moderate' for new; 'medium' accepted for backward compat)"
        },
        "end_line": {
          "type": "integer",
          "minimum": 0,
          "description": "End line of claim source in the source file"
        },
        "evidence_count": {
          "type": "integer",
          "description": "Number of supporting evidence items found for this claim"
        },
        "example_domain": {
          "type": "string",
          "description": "Domain or context of usage examples (e.g., '3D rendering', 'file conversion')"
        },
        "keyword_boost": {
          "type": ["number", "boolean"],
          "description": "Keyword relevance boost score for claim selection (number or boolean flag)"
        },
        "normalized_text": {
          "type": "string",
          "description": "Normalized form of claim_text for deduplication"
        },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Prerequisite claim_ids that must come first"
        },
        "section_kind": {
          "type": "string",
          "description": "Kind of section this claim belongs to (e.g., 'feature', 'workflow', 'install')"
        },
        "source_file": {
          "type": "string",
          "description": "Source file path where this claim was extracted"
        },
        "source_section": {
          "type": "string",
          "description": "Section of the source file where claim was found"
        },
        "start_line": {
          "type": "integer",
          "minimum": 0,
          "description": "Start line of claim source in the source file"
        },
        "steps": {
          "type": "array",
          "description": "Ordered steps if this claim represents a workflow or procedure",
          "items": { "type": "object", "additionalProperties": true }
        },
        "supporting_evidence": {
          "type": "array",
          "description": "Additional supporting evidence items beyond primary citations",
          "items": { "type": "object", "additionalProperties": true }
        },
        "target_persona": {
          "type": "string",
          "description": "Who this claim is for, e.g., 'Python developers building 3D applications'"
        },
        "use_cases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific use case scenarios where this claim applies"
        },
        "citation_quality_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Optional [0,1] evidence quality score from repo_profiler. Present only when LAUNCH_REPO_PROFILING=1."
        }
      }
    }
  }
}
