{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heal_plan.schema.json",
  "title": "Heal Plan",
  "description": "Audit trail for launch heal iterations (TC-2950).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "max_steps",
    "steps",
    "stop_reason",
    "final_failed_gate_count",
    "started_at_utc",
    "finished_at_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["strict", "aggressive"]
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/heal_step"
      }
    },
    "stop_reason": {
      "enum": [
        "all_gates_pass",
        "max_steps",
        "stuck",
        "no_recommendation",
        "dry_run",
        "resume_failed"
      ]
    },
    "final_failed_gate_count": {
      "type": "integer",
      "minimum": 0
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "heal_step": {
      "type": "object",
      "required": [
        "step_idx",
        "chosen_worker",
        "reason",
        "triage_snapshot",
        "failed_gate_count_before",
        "failed_gate_count_after",
        "exit_code",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "step_idx": {
          "type": "integer",
          "minimum": 0
        },
        "chosen_worker": {
          "type": "string",
          "pattern": "^W[0-9]{1,2}$"
        },
        "reason": {
          "type": "string"
        },
        "triage_snapshot": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "failed_gate_count_before": {
          "type": "integer",
          "minimum": 0
        },
        "failed_gate_count_after": {
          "type": "integer",
          "minimum": -1
        },
        "exit_code": {
          "type": "integer"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
