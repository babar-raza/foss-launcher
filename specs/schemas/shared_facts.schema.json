{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared Facts",
  "description": "Canonical facts extracted from product_facts for cross-page consistency (TC-2478).",
  "type": "object",
  "required": ["schema_version", "runtime_versions", "supported_formats", "product_slug"],
  "properties": {
    "schema_version": {"type": "string"},
    "runtime_versions": {
      "type": "object",
      "properties": {
        "python": {
          "type": "object",
          "properties": {
            "minimum": {"type": "string"},
            "all_mentioned": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "supported_formats": {"type": "array", "items": {"type": "string"}},
    "installation_method": {"type": "string"},
    "package_name": {"type": "string"},
    "product_display_name": {"type": "string"},
    "product_slug": {"type": "string"},
    "supported_platforms": {"type": "array", "items": {"type": "string"}},
    "license": {
      "type": "object",
      "properties": {
        "spdx_id": {"type": "string"},
        "name": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
