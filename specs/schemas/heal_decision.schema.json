{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "heal_decision.schema.json",
  "title": "HealDecision",
  "description": "LLM diagnostician output for one heal step",
  "type": "object",
  "required": ["analysis", "root_causes", "action", "confidence", "stop_recommendation"],
  "additionalProperties": false,
  "properties": {
    "analysis": {"type": "string", "minLength": 1},
    "root_causes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "action": {
      "type": "object",
      "required": ["worker", "target_pages", "strategy", "priority_checks"],
      "additionalProperties": false,
      "properties": {
        "worker": {"type": "string", "enum": ["understand", "planner", "generate"]},
        "target_pages": {"type": "array", "items": {"type": "string"}},
        "strategy": {"type": "string", "minLength": 1},
        "priority_checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "stop_recommendation": {"type": "boolean"},
    "stop_reason": {"type": ["string", "null"]}
  }
}
