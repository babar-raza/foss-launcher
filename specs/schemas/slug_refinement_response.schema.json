{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "slug_refinement_response.schema.json",
  "title": "Slug Refinement Response",
  "description": "TC-2609: Schema for LLM-generated SEO slug refinement candidates in W6.",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["slug", "rationale"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
            "maxLength": 60,
            "description": "SEO-optimized URL slug candidate."
          },
          "rationale": {
            "type": "string",
            "maxLength": 200,
            "description": "Brief explanation of why this slug is SEO-optimal."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
