{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_created.schema.json",
  "title": "run_created event",
  "description": "Emitted when a new pipeline run is created.",
  "type": "object",
  "properties": {
    "type": {
      "const": "run_created"
    },
    "run_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "config": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "repo_url": {
          "type": "string"
        }
      },
      "required": ["family", "platform", "repo_url"],
      "additionalProperties": false
    }
  },
  "required": ["type", "run_id", "timestamp", "config"],
  "additionalProperties": false
}
