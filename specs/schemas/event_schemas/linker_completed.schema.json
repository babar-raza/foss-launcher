{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linker_completed.schema.json",
  "title": "linker_completed event",
  "description": "Emitted when the cross-page linker finishes in GenerateWorker.",
  "type": "object",
  "properties": {
    "type": {
      "const": "linker_completed"
    },
    "run_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "worker": {
      "type": "string"
    },
    "cross_links": {
      "type": "integer",
      "minimum": 0
    },
    "see_also": {
      "type": "integer",
      "minimum": 0
    },
    "toc_child": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["type", "run_id", "timestamp", "worker", "cross_links", "see_also", "toc_child"],
  "additionalProperties": false
}
