{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker_started.schema.json",
  "title": "worker_started event",
  "description": "Emitted when a worker begins execution.",
  "type": "object",
  "properties": {
    "type": {
      "const": "worker_started"
    },
    "run_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "worker": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    }
  },
  "required": ["type", "run_id", "timestamp", "worker"],
  "additionalProperties": false
}
